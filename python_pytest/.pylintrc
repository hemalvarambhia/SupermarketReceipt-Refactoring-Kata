[MASTER]

# Disable specific messages
disable=C0301,W0703,R0913,C0114,C0115,C0116

output-format=colorized

[BASIC]

# Configure naming style
good-names=i,j,k,ex,Run,_

[DESIGN]

# Set the maximum number of arguments for a function or method
max-args=5

# Set the maximum number of attributes in a class
max-attributes=2

# Set the maximum number of public methods in a class
max-public-methods=6

max-locals = 15   # Set the limit for the number of local variables
max-returns = 6   # Set the limit for the number of return statements
max-branches = 12  # Set the limit for the number of branches
max-statements = 10  # Set the limit for the number of statements
